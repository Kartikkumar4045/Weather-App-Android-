<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- SearchBar style -->
    <style name="RoundedSearchBar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Date card style -->
    <style name="DateCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@android:color/white</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="android:layout_margin">4dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>