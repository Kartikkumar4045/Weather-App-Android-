<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sunny_background"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="45dp">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/searchviewshape"
            app:iconifiedByDefault="true"
            app:queryHint="Search For A City"
            app:searchIcon="@drawable/search"
            tools:layout_editor_absoluteX="8dp"
            tools:layout_editor_absoluteY="45dp" >
        </androidx.appcompat.widget.SearchView>

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridLayoutDates"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="10dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/searchView"
            app:layout_constraintBottom_toTopOf="@id/cityName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:rowCount="1"
            app:columnCount="5">

            <!-- Card Template Start -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDay1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="4dp"
                app:layout_columnWeight="1"
                android:background="@drawable/searchviewshape">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="4dp">
                    <TextView
                        android:id="@+id/firstDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUN"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/firstDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25, MAY"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Repeat the same Card 4 more times below with same changes -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDay2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="4dp"
                app:layout_columnWeight="1"
                android:background="@drawable/searchviewshape">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="4dp">
                    <TextView
                        android:id="@+id/secondDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUN"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/secondDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25, MAY"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Repeat similarly for Card 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDay3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="4dp"
                app:layout_columnWeight="1"
                android:background="@drawable/searchviewshape">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="4dp">
                    <TextView
                        android:id="@+id/thirdDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUN"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/thirdDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25, MAY"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 4 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDay4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="4dp"
                app:layout_columnWeight="1"
                android:background="@drawable/searchviewshape">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="4dp">
                    <TextView
                        android:id="@+id/fourthDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUN"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/fourthDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25, MAY"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 5 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDay5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="4dp"
                app:layout_columnWeight="1"
                android:background="@drawable/searchviewshape">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="4dp">
                    <TextView
                        android:id="@+id/fifthDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUN"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/fifthDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25, MAY"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.gridlayout.widget.GridLayout>



        <TextView
            android:id="@+id/cityName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/loctaion"
            android:drawablePadding="15dp"
            android:fontFamily="@font/merriweathersans_medium"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/gridLayoutDates"
            app:layout_constraintEnd_toEndOf="@+id/searchView"
            app:layout_constraintStart_toStartOf="@+id/searchView"
            tools:layout_editor_absoluteY="109dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cityName"
            android:layout_marginTop="8dp"
            tools:layout_editor_absoluteY="71dp"
            android:isScrollContainer="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/insideConstraintLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieAnimationView"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/insideConstraintLayout"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/sun" />

                <TextView
                    android:id="@+id/selactedDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="30dp"
                    android:fontFamily="@font/merriweathersans_bold"
                    android:text="Today"
                    android:textColor="@color/black"
                    android:textSize="34sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/merriweathersans_bold"
                    android:text="00.00 °C"
                    android:textColor="@color/black"
                    android:textSize="50sp"
                    app:layout_constraintEnd_toEndOf="@+id/selactedDay"
                    app:layout_constraintStart_toStartOf="@+id/selactedDay"
                    app:layout_constraintTop_toBottomOf="@+id/selactedDay" />

                <TextView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/merriweathersans_medium"
                    android:text="Time : 00.00"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="@+id/weather"
                    app:layout_constraintEnd_toEndOf="@+id/temp"
                    app:layout_constraintStart_toStartOf="@+id/temp"
                    app:layout_constraintTop_toTopOf="@+id/weather" />

                <TextView
                    android:id="@+id/weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/merriweathersans_medium"
                    android:text="SUNNY"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    app:layout_constraintStart_toStartOf="@+id/lottieAnimationView"
                    app:layout_constraintEnd_toEndOf="@id/lottieAnimationView"
                    app:layout_constraintTop_toBottomOf="@+id/lottieAnimationView" />

                <TextView
                    android:id="@+id/max_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:fontFamily="@font/merriweathersans_regular"
                    android:text="Max : 00.00 °C"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="@+id/time"
                    app:layout_constraintStart_toStartOf="@+id/weather"
                    app:layout_constraintTop_toBottomOf="@+id/time" />

                <TextView
                    android:id="@+id/min_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/merriweathersans_regular"
                    android:text="Min : 00.00 °C"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="@+id/max_temp"
                    app:layout_constraintStart_toStartOf="@+id/max_temp"
                    app:layout_constraintTop_toBottomOf="@+id/max_temp" />

                <TextView
                    android:id="@+id/day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/merriweathersans_bold"
                    android:text="Tuesday"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="@+id/min_temp"
                    app:layout_constraintStart_toStartOf="@+id/min_temp"
                    app:layout_constraintTop_toBottomOf="@+id/min_temp" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/merriweathersans_regular"
                    android:text="13 May 2005"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@+id/day"
                    app:layout_constraintStart_toStartOf="@+id/day"
                    app:layout_constraintTop_toBottomOf="@+id/day" />

                <FrameLayout
                    android:id="@+id/frameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/backgroundshape"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/date">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:id="@+id/linearLayout"
                            android:layout_width="80dp"
                            android:layout_height="88dp"
                            android:background="@drawable/backgroundshape"
                            android:gravity="bottom|center_vertical"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:srcCompat="@drawable/humidity" />

                            <TextView
                                android:id="@+id/humidity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="0.0 %"
                                android:textColor="@color/black" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="Humidity"
                                android:textColor="@color/black"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearLayout2"
                            android:layout_width="80dp"
                            android:layout_height="88dp"
                            android:background="@drawable/backgroundshape"
                            android:gravity="bottom|center_vertical"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:srcCompat="@drawable/wind" />

                            <TextView
                                android:id="@+id/windSpeed"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="0.00 m/s"
                                android:textColor="@color/black" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="Wind Speeed"
                                android:textColor="@color/black"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearLayout3"
                            android:layout_width="80dp"
                            android:layout_height="88dp"
                            android:background="@drawable/backgroundshape"
                            android:gravity="bottom|center_vertical"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:srcCompat="@drawable/conditions" />

                            <TextView
                                android:id="@+id/condition"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="SUNNY"
                                android:textAllCaps="true"
                                android:textColor="@color/black" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="Condition"
                                android:textColor="@color/black"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearLayout4"
                            android:layout_width="80dp"
                            android:layout_height="88dp"
                            android:background="@drawable/backgroundshape"
                            android:gravity="bottom|center_vertical"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:srcCompat="@drawable/sunrise" />

                            <TextView
                                android:id="@+id/sunrise"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="00:00"
                                android:textColor="@color/black" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="Sunrise"
                                android:textColor="@color/black"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearLayout5"
                            android:layout_width="80dp"
                            android:layout_height="88dp"
                            android:background="@drawable/backgroundshape"
                            android:gravity="bottom|center_vertical"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:srcCompat="@drawable/sunset" />

                            <TextView
                                android:id="@+id/sunset"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="00:00"
                                android:textColor="@color/black" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="Sunset"
                                android:textColor="@color/black"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearLayout6"
                            android:layout_width="80dp"
                            android:layout_height="88dp"
                            android:background="@drawable/backgroundshape"
                            android:gravity="bottom|center_vertical"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:srcCompat="@drawable/sea" />

                            <TextView
                                android:id="@+id/sea"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="000 hPa"
                                android:textColor="@color/black" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:fontFamily="@font/merriweathersans_medium"
                                android:gravity="center"
                                android:text="Sea Level"
                                android:textColor="@color/black"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <androidx.constraintlayout.helper.widget.Flow
                            android:id="@+id/flow"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            app:constraint_referenced_ids="linearLayout,linearLayout2,linearLayout3,linearLayout4,linearLayout5,linearLayout6,textView11"
                            app:flow_maxElementsWrap="3"
                            app:flow_wrapMode="chain"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:ignore="NotSibling" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </FrameLayout>

                <TextView
                    android:id="@+id/textView11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="180dp"
                    android:fontFamily="@font/merriweathersans_medium"
                    android:text="DESIGN BY\nKartik"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/frameLayout" />


            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>